// Prisma schema for Basis — a professional trading journal.
// See ARCHITECTURE.md for the rationale behind model boundaries.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  FREE
  PRO
  PRO_PLUS
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Billing — Lemon Squeezy is the source of truth; these fields are a cache
  // kept in sync by the webhook handler (src/app/api/lemonsqueezy/webhook/route.ts).
  // Never trust client-supplied plan/status — always read these columns.
  lemonSqueezyCustomerId     String?            @unique
  lemonSqueezySubscriptionId String?            @unique
  subscriptionPlan           SubscriptionPlan   @default(FREE)
  subscriptionStatus         SubscriptionStatus @default(FREE)
  billingInterval            BillingInterval?
  currentPeriodEnd           DateTime?
  cancelAtPeriodEnd          Boolean            @default(false)
  subscriptionStartedAt      DateTime?
  subscriptionCanceledAt     DateTime?

  /**
   * Null until the user clicks through the first-run welcome screen —
   * everything after that (including pre-existing users, backfilled at
   * migration time) is treated as a "welcome back" visit instead.
   */
  welcomedAt DateTime?

  /**
   * Gates /admin (issue report review). Set directly in the DB — there's
   * no self-service way to become an admin, and no UI exposes this flag.
   */
  isAdmin Boolean @default(false)

  settings            UserSettings?
  tradingAccounts     TradingAccount[]
  trades              Trade[]
  strategies          Strategy[]
  playbooks           Playbook[]
  checklists          Checklist[]
  mistakes            Mistake[]
  screenshots         Screenshot[]
  journalEntries      JournalEntry[]
  goals               Goal[]
  importJobs          ImportJob[]
  importMappings      ImportMapping[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  tradingViewWebhooks TradingViewWebhook[]
  issueReports        IssueReport[]
  suggestions         Suggestion[]
  friendshipsSent     Friendship[]         @relation("FriendshipRequester")
  friendshipsReceived Friendship[]         @relation("FriendshipReceiver")
  tradeRatingsGiven   TradeRating[]
}

/**
 * Dedupes processed Lemon Squeezy webhook deliveries so a redelivered/
 * duplicate event is a no-op instead of double-applying (e.g. double-
 * extending a billing period). Unlike Stripe, Lemon Squeezy webhook payloads
 * don't carry a stable per-event ID, so the primary key is a hash of
 * (event name + raw body) computed in the webhook handler — same pattern as
 * TradingViewWebhookEvent.
 */
model LemonSqueezyWebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model UserSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                  String   @default("dark")
  baseCurrency           String   @default("USD")
  timezone               String   @default("America/New_York")
  defaultRiskPerTradePct Decimal? @db.Decimal(6, 3)
  maxDailyLossPct        Decimal? @db.Decimal(6, 3)
  maxWeeklyLossPct       Decimal? @db.Decimal(6, 3)
  notificationsEnabled   Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Trading accounts
// ---------------------------------------------------------------------------

enum TradingAccountType {
  BROKERAGE
  FUTURES
  FOREX
  CRYPTO
  PROP_FIRM
  PAPER
  OTHER
}

enum TradingAccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

model TradingAccount {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  broker          String?
  accountType     TradingAccountType
  startingBalance Decimal              @db.Decimal(20, 8)
  currency        String               @default("USD")
  status          TradingAccountStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  trades              Trade[]
  importJobs          ImportJob[]
  tradingViewWebhooks TradingViewWebhook[]

  @@index([userId])
}

/**
 * A per-account incoming webhook for TradingView alerts (Pine Script
 * strategy alerts posting a JSON message). There is no way to verify these
 * requests came from TradingView specifically — the URL's token IS the only
 * secret, exactly like Slack/Zapier incoming webhooks — so the raw token is
 * shown to the user only once at creation and stored here only as a hash.
 */
model TradingViewWebhook {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingAccountId  String
  tradingAccount    TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  label             String
  tokenHash         String         @unique
  defaultAssetClass AssetClass     @default(EQUITY)
  createdAt         DateTime       @default(now())
  lastTriggeredAt   DateTime?

  @@index([userId])
}

/**
 * Dedupes TradingView webhook deliveries, the same way StripeWebhookEvent
 * dedupes Stripe's: a redelivered/replayed alert with a byte-identical body
 * is a no-op instead of creating a duplicate execution. The primary key is a
 * hash of (webhook id + raw request body), so two different webhooks can't
 * collide with each other and a replayed capture of the exact same request
 * is always recognized regardless of when it's resent.
 */
model TradingViewWebhookEvent {
  id        String   @id
  webhookId String
  createdAt DateTime @default(now())

  @@index([webhookId])
}

// ---------------------------------------------------------------------------
// Trades & executions
// ---------------------------------------------------------------------------

enum AssetClass {
  EQUITY
  OPTION
  FUTURES
  FOREX
  CRYPTO
  OTHER
}

enum TradeDirection {
  LONG
  SHORT
}

enum TradeStatus {
  OPEN
  CLOSED
}

enum TradingSession {
  PRE_MARKET
  OPEN
  MIDDAY
  POWER_HOUR
  AFTER_HOURS
  OVERNIGHT
}

enum ExecutionSide {
  BUY
  SELL
}

model Trade {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingAccountId String
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  symbol     String
  assetClass AssetClass
  direction  TradeDirection
  status     TradeStatus    @default(OPEN)

  // Derived from executions by the P&L engine — never hand-edited once executions exist.
  quantity      Decimal   @db.Decimal(20, 8)
  avgEntryPrice Decimal   @db.Decimal(20, 8)
  avgExitPrice  Decimal?  @db.Decimal(20, 8)
  entryAt       DateTime
  exitAt        DateTime?

  // Dollars of P&L per 1.00 price move, per unit of quantity. 1 for
  // shares/units-style instruments; a futures contract's point value
  // otherwise (e.g. 2 for Micro Nasdaq/MNQ) — see src/lib/futures-contracts.ts.
  contractMultiplier Decimal @default(1) @db.Decimal(20, 8)

  stopLoss   Decimal? @db.Decimal(20, 8)
  takeProfit Decimal? @db.Decimal(20, 8)

  fees       Decimal  @default(0) @db.Decimal(20, 8)
  commission Decimal  @default(0) @db.Decimal(20, 8)
  grossPnl   Decimal? @db.Decimal(20, 8)
  netPnl     Decimal? @db.Decimal(20, 8)

  riskAmount  Decimal? @db.Decimal(20, 8)
  riskPercent Decimal? @db.Decimal(8, 4)
  rMultiple   Decimal? @db.Decimal(10, 4)

  strategyId String?
  strategy   Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  playbookId String?
  playbook   Playbook? @relation(fields: [playbookId], references: [id], onDelete: SetNull)

  session         TradingSession?
  marketCondition String?

  emotionBefore   String?
  emotionDuring   String?
  emotionAfter    String?
  confidence      Int?
  executionRating Int?
  ruleAdherence   Int?

  notesBefore         String?
  notesDuring         String?
  notesAfter          String?
  reviewWhatWentWell  String?
  reviewWhatWentWrong String?
  reviewWhatToChange  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions       Execution[]
  mistakes         TradeMistake[]
  screenshots      Screenshot[]
  checklistEntries TradeChecklistItem[]
  friendRatings    TradeRating[]

  @@index([userId])
  @@index([tradingAccountId])
  @@index([userId, entryAt])
  @@index([symbol])
}

model Execution {
  id         String        @id @default(cuid())
  tradeId    String
  trade      Trade         @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  side       ExecutionSide
  quantity   Decimal       @db.Decimal(20, 8)
  price      Decimal       @db.Decimal(20, 8)
  executedAt DateTime
  fees       Decimal       @default(0) @db.Decimal(20, 8)
  commission Decimal       @default(0) @db.Decimal(20, 8)
  createdAt  DateTime      @default(now())

  @@index([tradeId])
}

// ---------------------------------------------------------------------------
// Strategies & playbooks
// ---------------------------------------------------------------------------

model Strategy {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  rules            String?
  entryCriteria    String?
  exitCriteria     String?
  stopLossRules    String?
  takeProfitRules  String?
  timeframe        String?
  marketConditions String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trades      Trade[]
  screenshots Screenshot[]

  @@index([userId])
}

model Playbook {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  setupDescription String?
  entryRules       String?
  stopRules        String?
  targetRules      String?
  invalidations    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trades      Trade[]
  checklists  Checklist[]
  screenshots Screenshot[]

  @@index([userId])
}

model Checklist {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  playbookId String?
  playbook   Playbook? @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  name       String
  createdAt  DateTime  @default(now())

  items ChecklistItem[]

  @@index([userId])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  label       String
  sortOrder   Int       @default(0)

  tradeEntries TradeChecklistItem[]

  @@index([checklistId])
}

model TradeChecklistItem {
  id              String        @id @default(cuid())
  tradeId         String
  trade           Trade         @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  checklistItemId String
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  completed       Boolean       @default(false)

  @@unique([tradeId, checklistItemId])
}

// ---------------------------------------------------------------------------
// Tags & mistakes
// ---------------------------------------------------------------------------

model Mistake {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())

  trades TradeMistake[]

  @@unique([userId, name])
}

model TradeMistake {
  tradeId   String
  trade     Trade   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  mistakeId String
  mistake   Mistake @relation(fields: [mistakeId], references: [id], onDelete: Cascade)

  @@id([tradeId, mistakeId])
}

// ---------------------------------------------------------------------------
// Screenshots
// ---------------------------------------------------------------------------

enum ScreenshotKind {
  ENTRY
  EXIT
  BEFORE
  AFTER
  OTHER
}

model Screenshot {
  id      String         @id @default(cuid())
  userId  String
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind    ScreenshotKind @default(OTHER)
  url     String
  caption String?

  tradeId        String?
  trade          Trade?        @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  strategyId     String?
  strategy       Strategy?     @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  playbookId     String?
  playbook       Playbook?     @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tradeId])
}

// ---------------------------------------------------------------------------
// Journal
// ---------------------------------------------------------------------------

model JournalEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  marketOverview  String?
  tradingPlan     String?
  goals           String?
  mentalState     String?
  importantLevels String?
  newsEvents      String?
  endOfDayReview  String?
  lessonsLearned  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  screenshots Screenshot[]

  @@unique([userId, date])
}

// ---------------------------------------------------------------------------
// Goals
// ---------------------------------------------------------------------------

enum GoalMetric {
  MAX_DAILY_LOSS
  MONTHLY_PNL_TARGET
  TRADE_COUNT
  WIN_RATE
  AVERAGE_R
  RULE_FOLLOWING
}

enum GoalPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric      GoalMetric
  period      GoalPeriod
  targetValue Decimal    @db.Decimal(20, 8)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Import
// ---------------------------------------------------------------------------

enum ImportStatus {
  PENDING
  MAPPING
  VALIDATING
  READY
  IMPORTING
  COMPLETED
  FAILED
}

model ImportJob {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingAccountId String?
  tradingAccount   TradingAccount? @relation(fields: [tradingAccountId], references: [id], onDelete: SetNull)
  broker           String?
  fileName         String
  status           ImportStatus    @default(PENDING)
  rowCount         Int             @default(0)
  importedCount    Int             @default(0)
  skippedCount     Int             @default(0)
  errorCount       Int             @default(0)
  errorLog         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
}

model ImportMapping {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker    String
  mapping   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, broker])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  DAILY_LOSS_LIMIT
  WEEKLY_DRAWDOWN
  MISSING_JOURNAL
  REVIEW_REMINDER
  RISK_LIMIT
  WEEKLY_REVIEW
  FRIEND_REQUEST_RECEIVED
  FRIEND_REQUEST_ACCEPTED
  TRADE_RATED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  // Identifies the specific occurrence a notification is about (e.g. a date
  // or week), so generation can upsert instead of creating duplicates every
  // time it runs.
  dedupeKey String
  // Where clicking the notification should go. The six original types are
  // periodic/derived and link to a fixed page (handled by the bell's static
  // TYPE_META map); event-driven types (friend requests, trade ratings)
  // point at a specific trade/friend, so they set this instead.
  link      String?
  createdAt DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Friends
// ---------------------------------------------------------------------------

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

/**
 * A friend request/connection between two users. Symmetric once ACCEPTED —
 * either user's trades become visible to the other (see src/lib/friendship.ts).
 * Declining or removing a friend deletes the row outright rather than
 * tracking a DECLINED state, so a fresh request can be sent later without
 * the unique constraint blocking it.
 */
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User             @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, receiverId])
  @@index([receiverId])
  @@index([requesterId])
}

/**
 * One friend's rating + note on a trade — upserted, not a comment thread:
 * each rater has exactly one rating/note per trade, editable in place.
 */
model TradeRating {
  id        String   @id @default(cuid())
  tradeId   String
  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  raterId   String
  rater     User     @relation(fields: [raterId], references: [id], onDelete: Cascade)
  rating    Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tradeId, raterId])
  @@index([tradeId])
  @@index([raterId])
}

/**
 * A user-submitted bug/feedback report from the Help page. No triage
 * workflow yet (status, replies) — just `resolved` so an eventual admin
 * view can filter, deliberately minimal until report volume justifies more.
 */
model IssueReport {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  pageUrl     String
  userAgent   String?
  plan        SubscriptionPlan
  resolved    Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([userId])
}

/**
 * A user-submitted feature idea, separate from IssueReport (bug/feedback) —
 * reviewed on the same /admin page, under its own tab.
 */
model Suggestion {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  pageUrl     String
  plan        SubscriptionPlan
  resolved    Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([userId])
}
